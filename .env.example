# Copy to .env.local and fill in. Never commit .env.local.
MODEL_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" to serve frozen fixtures instead of live Meta calls (Phase 7).
USE_CACHED=false
# Override scratch dir (defaults to /tmp/opencode/gridsight).
# GRIDSIGHT_TMP_DIR=/tmp/opencode/gridsight
# Spark provider switch for tagging + report generation: meta (default) | baseten | modal.
# Env var only — there is no UI picker. "meta" behaves exactly as before.
# SPARK_PROVIDER=meta
# Optional model override for the Meta endpoint (default muse-spark-1.3).
# SPARK_MODEL=muse-spark-1.3
# Baseten (Muse Spark Open): model id MUST be meta-models/muse-spark-open-1026.
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_API_KEY=
# Modal (serve Muse Spark Open yourself; both required, key always required):
# MODAL_BASE_URL=
# MODAL_MODEL=
# MODAL_API_KEY=
